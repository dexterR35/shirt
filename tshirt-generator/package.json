{
  "name": "tshirt-generator-codex",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Local football shirt SVG studio with source-preserving kit research.",
  "scripts": {
    "data:prepare": "node scripts/prepare-data.mjs",
    "data:verify": "node scripts/verify-data.mjs",
    "starter:generate": "node scripts/generate-starter.mjs",
    "dev": "vite --host 0.0.0.0",
    "build": "npm run catalog:build && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "catalog:build": "node scripts/prepare-png-base.mjs && node scripts/build-catalog.mjs",
    "base:prepare": "node scripts/prepare-png-base.mjs",
    "base:analyze": "node scripts/trace-new-base.mjs",
    "base:analyze:legacy": "node scripts/analyze-base.mjs",
    "model:prepare": "node scripts/prepare-3d-model.mjs",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "research:links": "node scripts/check-seed-links.mjs",
    "research:checkpoint": "node scripts/checkpoint-research.mjs",
    "research:fka:import": "node scripts/research/fka-import.mjs --download",
    "research:fka:scrape": "node scripts/research/fka-scrape.mjs",
    "research:fka:review": "node scripts/research/fka-review.mjs"
  },
  "dependencies": {
    "@jsquash/avif": "2.1.1",
    "@tanstack/react-table": "9.2.4",
    "fflate": "0.8.3",
    "gsap": "3.15.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.0",
    "@gltf-transform/extensions": "4.5.0",
    "@gltf-transform/functions": "4.5.0",
    "@playwright/test": "1.63.0",
    "@vitejs/plugin-react": "6.1.1",
    "meshoptimizer": "1.2.0",
    "sharp": "0.35.4",
    "vite": "8.3.0"
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
